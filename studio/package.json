{
  "name": "dds-studio",
  "private": true,
  "version": "0.2.0",
  "description": "DDS Studio — двухканальный DDS 1 ГГц с 48-битным аккумулятором",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "server": "cargo run --release -p dds-server --",
    "web": "vite build && cargo run --release -p dds-server",
    "app": "cargo run --release -p dds-egui",
    "test": "cargo test -p dds-core -p dds-egui"
  },
  "dependencies": {
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "vite": "^7.3.7"
  }
}
