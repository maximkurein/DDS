# Git attributes for DDS Studio — единые окончания строк на всех платформах

* text=auto

# Windows-скрипты — CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Unix-скрипты и исходники — LF
*.sh text eol=lf
*.py text eol=lf
*.rs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.ino text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
Cargo.lock text eol=lf

# Бинарные файлы
*.png binary
*.ico binary
*.icns binary
*.pdf binary
